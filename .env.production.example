ENVIRONMENT=production
PROJECT_NAME="AI Companion Backend"

# Database & Core Services (REQUIRED)
DATABASE_URL=postgresql://user:password@host:port/db
GROQ_API_KEY=your_groq_production_api_key
REDIS_URL=redis://localhost:6379/0

# Security (REQUIRED)
SECRET_KEY=generate_a_secure_random_string
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Vector Database (REQUIRED for Production memory)
QDRANT_URL=https://your-qdrant-cluster-url.com
QDRANT_API_KEY=your_qdrant_api_key

# WhatsApp Integration (REQUIRED)
WHATSAPP_TOKEN=your_meta_production_token
WHATSAPP_PHONE_NUMBER_ID=your_production_phone_id
WHATSAPP_VERIFY_TOKEN=your_secure_verify_token
META_APP_SECRET=your_meta_app_secret

# Email Sender (REQUIRED)
RESEND_API_KEY=your_resend_production_api_key
