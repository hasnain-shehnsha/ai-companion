# QDRANT_API_KEY=

# Local WhatsApp Testing (requires Ngrok)
# WHATSAPP_TOKEN=dev_whatsapp_token
# WHATSAPP_PHONE_NUMBER_ID=dev_phone_id
# WHATSAPP_VERIFY_TOKEN=dev_verify_token
